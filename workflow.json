      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Candidate Onboarding Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "kodewar-candidate-onboarding-webhook"
    },
    {
      "parameters": {
        "jsCode": "// 1. Validate & Normalize Candidate Payload from Vercel\nconst raw = items[0].json.body || items[0].json;\n\nconst userName = String(raw.user_name || raw.userName || raw.name || '').trim();\nconst userEmail = String(raw.user_email || raw.userEmail || raw.email || '').trim().toLowerCase();\nconst userCourse = String(raw.user_course || raw.userCourse || raw.course || 'Internship Training Program').trim();\nconst tempPassword = String(raw.temp_password || raw.tempPassword || raw.password || '').trim();\nconst candidateId = String(raw.candidate_id || raw.candidateId || '').trim();\nconst eventType = String(raw.event_type || raw.eventType || 'candidate_created').trim();\nconst loginUrl = String(raw.login_url || raw.loginUrl || 'https://kodewar.vercel.app/login').trim();\nconst adminEmail = String(raw.admin_email || raw.adminEmail || 'admin@kodewar.com').trim();\n\nif (!userEmail) {\n  throw new Error('Validation Error: user_email is required');\n}\nif (!userName) {\n  throw new Error('Validation Error: user_name is required');\n}\nif (!tempPassword) {\n  throw new Error('Validation Error: temp_password is required');\n}\n\nreturn [{\n  json: {\n    user_name: userName,\n    user_email: userEmail,\n    user_course: userCourse,\n    temp_password: tempPassword,\n    candidate_id: candidateId,\n    event_type: eventType,\n    login_url: loginUrl,\n    admin_email: adminEmail,\n    is_resend: eventType === 'resend_activation',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Validate & Prepare Candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Personalize onboarding instructions for intern {{ $json.user_name }} enrolled in {{ $json.user_course }}. Verify credentials formatting and generate a warm, encouraging welcome tone tailored to their internship journey.",
        "options": {
          "systemMessage": "You are the Kodewar Technologies AI Onboarding Agent. Kodewar Technologies (Learn. Build. Grow.) is a technology training firm.\nEnsure all candidate details (Username, Course, Email, Temporary Password) are accurately organized and provide an encouraging, professional welcoming tone."
        }
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Onboarding AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        720,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        720,
        500
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "googleGeminiApi",
          "name": "Google Gemini API account"
        }
